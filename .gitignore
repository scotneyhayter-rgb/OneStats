# === Secrets & environment (NEVER commit) ===
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
# Signing / certificate material (updater keypair, Authenticode, etc.) — NEVER commit.
# The Tauri updater PRIVATE key (minisign .key) signs every release; keep it in a
# password manager / CI secret only. The .pub is public and may be committed deliberately.
*.p12
*.p8
*.cer
*.crt
*.jks
*.minisign
*.keystore
secrets/
.pgpass
# One-time super-admin setup token (first run)
.onestats-setup-token
**/.onestats-setup-token
# Uploaded media (logos, etc.) — workspace artwork, not source.
# NOTE: match the runtime media_root only, never the onestats.domain.media source package.
services/api/media/
/media/

# === Real cricket data / exports / media (provenance & privacy) ===
fixtures-private/
*.mxp
# Cricket Statz / real workspace data must never enter source control
data-private/
*.onestats-export.json

# === Python ===
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage/
dist/
build/

# === Node / frontend ===
node_modules/
apps/*/dist/
apps/*/.vite/
*.local

# === Rust / Tauri ===
target/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# === Logs & local ===
*.log
logs/
.DS_Store
Thumbs.db

# === Editor ===
.vscode/*
!.vscode/extensions.json
.idea/

# === Claude Code local session tooling ===
# Local git worktrees created for side sessions — never part of the repo.
.claude/worktrees/
.claude/settings.local.json
.claude/projects/
