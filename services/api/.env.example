# OneStats API — example environment. Copy to `.env` (gitignored) and fill in locally.
# NEVER commit the real .env. Secrets stay out of source control, logs and Git.

ONESTATS_ENV=development
ONESTATS_LOG_LEVEL=INFO
ONESTATS_LOG_JSON=false

# --- Database (least-privilege app role) ---
ONESTATS_DB_HOST=localhost
ONESTATS_DB_PORT=5432
ONESTATS_DB_NAME=onestats
ONESTATS_DB_USER=onestats_app
# Runtime: the onestats_app (least-privilege, non-owner) password. Do NOT commit it.
ONESTATS_DB_PASSWORD=

# Option B (separate roles): the onestats_migrator (owner) password, used ONLY by Alembic
# to apply migrations. Safe to remove after the migration is applied. Do NOT commit it.
# ONESTATS_MIGRATOR_PASSWORD=

# (Advanced) full URL override for the runtime connection, instead of the parts above:
# ONESTATS_DB_URL=postgresql+psycopg://onestats_app:PASSWORD@localhost:5432/onestats
