{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneStats",
  "version": "1.0.0-beta.6",
  "identifier": "com.onestats.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneStats",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["onestats-server-dist/**/*"],
    "publisher": "OneStats",
    "copyright": "© OneStats",
    "category": "Utility",
    "shortDescription": "Cricket Statistics Made Simple",
    "longDescription": "OneStats — comprehensive cricket statistics, records, reporting and publishing for clubs and associations.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/scotneyhayter-rgb/OneStats/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2QkQ4ODQ2NkZENUZGOUEKUldTYS85VnZSb2k5MXFDbG5CR1AxY3dIeTZjWlFTRUFNV3BNVkNJS0lLaEZGelhoU2c2M1VlbUoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
